{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "ClientId": "local-client"
  },
  "Gateway": {
    "Limits": {
      "PostsPerMinute": 20,
      "FollowsPerMinute": 60,
      "AnonymousReadsPerMinute": 300
    }
  },
  "ReverseProxy": {
    "Routes": {
      "monolith": {
        "ClusterId": "monolith",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "monolith": {
        "Destinations": {
          "monolith": { "Address": "http://localhost:5180/" }
        }
      }
    }
  }
}

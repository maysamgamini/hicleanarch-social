<?xml version="1.0" encoding="utf-8"?>
<!-- Where packages come from (s3-l15). The BuildingBlocks come from the local feed, filled by
     scripts/pack-buildingblocks.sh (or "dotnet pack BuildingBlocks.slnx -o artifacts/packages");
     everything else from nuget.org. A clone builds with nothing but .NET and Docker. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="Social.BuildingBlocks.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.Neo4j" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- At most 8 tests at once: each holds a host with a connection pool per module, all on one server. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Host\Social.Host.csproj" />
    <!-- Both have a top-level Program: the gateway's is reached through its alias. -->
    <ProjectReference Include="..\..\src\Gateway\Social.Gateway.csproj" Aliases="gateway" />
  </ItemGroup>

</Project>
